<!-- Product Enquiry CTA -->
<section class="section pt-0">
    <div class="container">

        <div class="cta-panel reveal">

            <div class="row align-items-center g-4">

                <div class="col-lg-8">

                    <span class="cta-label">
                        Looking for another configuration?
                    </span>

                    <h2>
                        Tell us what product you need
                    </h2>

                    <p class="mb-lg-0">
                        Share your required brand, processor, RAM, storage,
                        quantity and budget through WhatsApp.
                    </p>

                </div>

                <div class="col-lg-4 text-lg-end">

                    <button type="button"
                            class="btn btn-light btn-lg fw-bold"
                            id="generalProductEnquiry">

                        <i class="fa-brands fa-whatsapp me-2"></i>
                        Send Requirement

                    </button>

                </div>

            </div>

        </div>

    </div>
</section>

@section Scripts {

    <script>
                document.addEventListener("DOMContentLoaded", function () {

                    const filterButtons =
                        document.querySelectorAll(".filter-btn");

                    const productItems =
                        document.querySelectorAll(".product-item");

                    const enquiryButtons =
                        document.querySelectorAll(".product-enquiry-btn");

                    const noProductsMessage =
                        document.getElementById("noProductsMessage");

                    filterButtons.forEach(function (button) {

                        button.addEventListener("click", function () {

                            const selectedCategory =
                                this.dataset.filter;

                            let visibleProducts = 0;

                            filterButtons.forEach(function (item) {
                                item.classList.remove("active");
                            });

                            this.classList.add("active");

                            productItems.forEach(function (product) {

                                const productCategory =
                                    product.dataset.category;

                                const shouldDisplay =
                                    selectedCategory === "all" ||
                                    selectedCategory === productCategory;

                                if (shouldDisplay) {

                                    product.classList.remove("d-none");

                                    product.style.animation = "none";

                                    window.requestAnimationFrame(function () {
                                        product.style.animation =
                                            "productShow 0.5s ease";
                                    });

                                    visibleProducts++;

                                } else {

                                    product.classList.add("d-none");

                                }

                            });

                            if (noProductsMessage) {

                                noProductsMessage.classList.toggle(
                                    "d-none",
                                    visibleProducts > 0
                                );

                            }

                        });

                    });

                    enquiryButtons.forEach(function (button) {

                        button.addEventListener("click", function () {

                            const productName =
                                this.dataset.product;

                            enquireProduct(productName);

                        });

                    });

                    const generalProductEnquiry =
                        document.getElementById("generalProductEnquiry");

                    if (generalProductEnquiry) {

                        generalProductEnquiry.addEventListener(
                            "click",
                            function () {

                                openWhatsApp(
        `Hello E-Waste Solutions,

        I am looking for a refurbished IT product.

        Required product:
        Brand:
        Processor:
        RAM:
        Storage:
        Quantity:
        Budget:
        Location:

        Please share available options.`
                                );

                            }
                        );

                    }

                });
    </script>

}