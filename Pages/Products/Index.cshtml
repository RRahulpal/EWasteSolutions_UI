@page
@model EWasteSolutions.Pages.ProductsModel

@{
    ViewData["Title"] = "Products";
}

<section class="products-page py-5">
    <div class="container">

        <div class="text-center mb-5">
            <span class="text-success fw-semibold text-uppercase">
                Refurbished Technology
            </span>

            <h1 class="fw-bold mt-2">
                Available Products
            </h1>

            <p class="text-muted mx-auto"
               style="max-width: 700px;">
                Explore quality refurbished laptops, desktops,
                monitors and accessories.
            </p>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="fa-solid fa-box-open fa-3x text-muted"></i>
                </div>

                <h4>No products are currently available</h4>

                <p class="text-muted">
                    Please check again later.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var product in Model.Products)
                {
                    var primaryImage =
                    product.ProductImages?
                    .FirstOrDefault(image => image.IsPrimary)
                    ?? product.ProductImages?.FirstOrDefault();

                    <div class="col-lg-4 col-md-6">
                        <div class="card product-card h-100 border-0 shadow-sm">

                            <div class="product-image-wrapper position-relative">

                                @if (primaryImage != null &&
                                                        !string.IsNullOrWhiteSpace(primaryImage.ImageUrl))
                                {
                                    <img src="@primaryImage.ImageUrl"
                                         alt="@product.Name"
                                         class="card-img-top product-image"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="product-image-placeholder">
                                        <i class="fa-regular fa-image fa-3x text-muted"></i>
                                    </div>
                                }

                                @if (product.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-3">
                                        Featured
                                    </span>
                                }

                                @if (product.Stock <= 0)
                                {
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-3">
                                        Out of Stock
                                    </span>
                                }
                            </div>

                            <div class="card-body d-flex flex-column">

                                <div class="small text-success fw-semibold mb-2">
                                    @(product.Category?.Name ?? "Product")
                                </div>

                                <h4 class="card-title">
                                    @product.Name
                                </h4>

                                @if (!string.IsNullOrWhiteSpace(product.Brand))
                                {
                                    <p class="text-muted mb-2">
                                        Brand: @product.Brand
                                    </p>
                                }

                                <div class="product-specifications mb-3">

                                    @if (!string.IsNullOrWhiteSpace(product.Processor))
                                    {
                                        <div>
                                            <strong>Processor:</strong>
                                            @product.Processor
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(product.Ram))
                                    {
                                        <div>
                                            <strong>RAM:</strong>
                                            @product.Ram
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(product.Storage))
                                    {
                                        <div>
                                            <strong>Storage:</strong>
                                            @product.Storage
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(product.Condition))
                                    {
                                        <div>
                                            <strong>Condition:</strong>
                                            @product.Condition
                                        </div>
                                    }
                                </div>

                                <div class="mt-auto">

                                    <div class="d-flex justify-content-between align-items-center mb-3">

                                        <div class="product-price">
                                            ₹@product.Price.ToString("N0")
                                        </div>

                                        @if (product.Stock > 0)
                                        {
                                            <span class="text-success small">
                                                In Stock
                                            </span>
                                        }
                                    </div>

                                    <a asp-page="/Product/Details"
                                       asp-route-id="@product.Id"
                                       class="btn btn-success w-100">
                                        View Details
                                    </a>

                                </div>

                            </div>

                        </div>
                    </div>
                }

            </div>
        }

    </div>
</section>