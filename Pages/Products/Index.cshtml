@page

@{
    ViewData["Title"] = "Refurbished Products";
}

<!-- Product Page Hero -->
<section class="page-hero product-page-hero">
    <div class="container">

        <div class="row align-items-center g-4">

            <div class="col-lg-7 hero-content-animation">

                <span class="eyebrow">
                    <i class="fa-solid fa-laptop me-2"></i>
                    Refurbished hardware
                </span>

                <h1>
                    Tested technology at
                    <span>better value</span>
                </h1>

                <p>
                    Explore professionally inspected refurbished laptops,
                    desktops, monitors, storage devices and accessories.
                    Product availability may change based on current stock.
                </p>

            </div>

            <div class="col-lg-5 text-center hero-image-animation">

                <img src="~/images/products/dell-latitude-5420.jpg"
                     class="img-fluid product-hero-image"
                     alt="Refurbished business laptop" />

            </div>

        </div>

    </div>
</section>

<!-- Product Catalogue -->
<section class="section">
    <div class="container">

        <!-- Heading -->
        <div class="section-title reveal">

            <span>Available categories</span>

            <h2>Explore refurbished products</h2>

            <p>
                Select a category to view matching products.
                Contact us through WhatsApp for price, warranty,
                stock availability and additional configurations.
            </p>

        </div>

        <!-- Product Filters -->
        <div class="product-filter-wrapper reveal">

            <button type="button"
                    class="btn btn-outline-brand filter-btn active"
                    data-filter="all">

                <i class="fa-solid fa-border-all me-2"></i>
                All Products

            </button>

            <button type="button"
                    class="btn btn-outline-brand filter-btn"
                    data-filter="laptop">

                <i class="fa-solid fa-laptop me-2"></i>
                Laptops

            </button>

            <button type="button"
                    class="btn btn-outline-brand filter-btn"
                    data-filter="desktop">

                <i class="fa-solid fa-computer me-2"></i>
                Desktops

            </button>

            <button type="button"
                    class="btn btn-outline-brand filter-btn"
                    data-filter="monitor">

                <i class="fa-solid fa-display me-2"></i>
                Monitors

            </button>

            <button type="button"
                    class="btn btn-outline-brand filter-btn"
                    data-filter="accessory">

                <i class="fa-solid fa-keyboard me-2"></i>
                Accessories

            </button>

        </div>

        <!-- Products -->
