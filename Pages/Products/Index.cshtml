                    <div class="product-image-wrapper">

                        <img src="~/images/products/dell-latitude-5420.jpg"
                             class="product-image"
                             alt="Dell Latitude 5420 refurbished laptop"
                             loading="lazy" />

                        <span class="product-condition-badge">
                            Grade A
                        </span>

                        <span class="product-stock-badge">
                            <i class="fa-solid fa-circle-check me-1"></i>
                            In Stock
                        </span>

                    </div>

                    <div class="product-card-body">

                        <span class="product-category">
                            Business Laptop
                        </span>

                        <h3 class="product-title">
                            Dell Latitude 5420
                        </h3>

                        <p class="product-description">
                            A dependable business-class laptop suitable for
                            office work, remote work and professional use.
                        </p>

                        <ul class="product-specification-list">

                            <li>
                                <i class="fa-solid fa-microchip"></i>
                                Intel Core i5 processor
                            </li>

                            <li>
                                <i class="fa-solid fa-memory"></i>
                                16 GB RAM
                            </li>

                            <li>
                                <i class="fa-solid fa-hard-drive"></i>
                                512 GB SSD
                            </li>

                            <li>
                                <i class="fa-solid fa-display"></i>
                                14-inch display
                            </li>

                        </ul>

                        <div class="product-card-footer">

                            <div>
