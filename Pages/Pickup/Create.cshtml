@page
@{ ViewData["Title"]="Request Pickup"; }
<section class="page-hero"><div class="container"><span class="eyebrow">Sell or recycle assets</span><h1>Request an e-waste pickup</h1><p>Enter your details below. The completed request will open directly in WhatsApp.</p></div></section>
<section class="section"><div class="container"><div class="row justify-content-center"><div class="col-xl-9"><div class="form-card"><form onsubmit="submitPickupForm(event)"><div class="row g-3"><div class="col-md-6"><label class="form-label">Your Name *</label><input class="form-control" name="name" required></div><div class="col-md-6"><label class="form-label">Company Name</label><input class="form-control" name="company"></div><div class="col-md-6"><label class="form-label">Phone Number *</label><input class="form-control" name="phone" required></div><div class="col-md-6"><label class="form-label">City *</label><input class="form-control" name="city" required></div><div class="col-md-6"><label class="form-label">Asset Type *</label><select class="form-select" name="assetType" required><option value="">Select asset</option><option>Laptops</option><option>Desktops</option><option>Servers</option><option>Monitors</option><option>Networking Equipment</option><option>Mixed E-Waste</option><option>Other</option></select></div><div class="col-md-6"><label class="form-label">Approximate Quantity *</label><input class="form-control" name="quantity" required placeholder="Example: 25 laptops"></div><div class="col-12"><label class="form-label">Pickup Address *</label><textarea class="form-control" rows="3" name="address" required></textarea></div><div class="col-12"><label class="form-label">Additional Details</label><textarea class="form-control" rows="4" name="details" placeholder="Condition, brands, preferred pickup date, etc."></textarea></div><div class="col-12"><div class="whatsapp-note mb-3"><i class="fa-brands fa-whatsapp me-2"></i>Your information is sent only through WhatsApp after you click the button.</div><button type="submit" class="btn btn-brand btn-lg">Continue on WhatsApp</button></div></div></form></div></div></div></div></section>
