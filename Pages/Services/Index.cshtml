@page
@{ ViewData["Title"]="Services"; }
<section class="page-hero"><div class="container"><span class="eyebrow">Our services</span><h1>End-to-end IT asset and e-waste solutions</h1><p>Flexible services for corporates, institutions, offices, resellers and individual customers.</p></div></section>
<section class="section"><div class="container"><div class="row g-4"><div class="col-md-6 col-lg-4"><div class="service-card"><div class="icon-box"><i class="fa-solid fa-computer"></i></div><h3>IT Asset Disposal</h3><p>Secure collection, sorting, valuation and disposal of obsolete IT hardware.</p><a asp-page="/Services/ITAssetDisposal">Learn more →</a></div></div><div class="col-md-6 col-lg-4"><div class="service-card"><div class="icon-box"><i class="fa-solid fa-trash-can-arrow-up"></i></div><h3>E-Waste Collection</h3><p>Collection support for laptops, desktops, monitors, printers, peripherals and mixed e-waste.</p></div></div><div class="col-md-6 col-lg-4"><div class="service-card"><div class="icon-box"><i class="fa-solid fa-shield-halved"></i></div><h3>Data Destruction</h3><p>Data wiping and physical destruction options for hard disks and storage media.</p><a asp-page="/Services/DataDestruction">Learn more →</a></div></div><div class="col-md-6 col-lg-4"><div class="service-card"><div class="icon-box"><i class="fa-solid fa-laptop-medical"></i></div><h3>Refurbishment</h3><p>Testing, repair, component replacement and remarketing of reusable hardware.</p><a asp-page="/Services/Refurbishment">Learn more →</a></div></div><div class="col-md-6 col-lg-4"><div class="service-card"><div class="icon-box"><i class="fa-solid fa-server"></i></div><h3>Server Disposal</h3><p>Handling of servers, racks, switches, routers and networking equipment.</p></div></div><div class="col-md-6 col-lg-4"><div class="service-card"><div class="icon-box"><i class="fa-solid fa-file-circle-check"></i></div><h3>Documentation Support</h3><p>Structured records and supporting documentation based on the agreed service scope.</p></div></div></div></div></section>
