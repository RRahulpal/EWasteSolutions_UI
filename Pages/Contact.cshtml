@page
@{
    ViewData["Title"] = "Contact";
}
<section class="page-hero"><div class="container"><span class="eyebrow">Contact us</span><h1>Let’s discuss your requirement</h1><p>Complete the form and your message will open in WhatsApp. No information is stored on this website.</p></div></section>
<section class="section"><div class="container"><div class="row g-4"><div class="col-lg-7"><div class="form-card"><form onsubmit="submitContactForm(event)"><div class="row g-3"><div class="col-md-6"><label class="form-label">Name *</label><input class="form-control" name="name" required></div><div class="col-md-6"><label class="form-label">Company</label><input class="form-control" name="company"></div><div class="col-md-6"><label class="form-label">Phone *</label><input class="form-control" name="phone" required></div><div class="col-md-6"><label class="form-label">Email</label><input type="email" class="form-control" name="email"></div><div class="col-12"><label class="form-label">Message *</label><textarea class="form-control" rows="5" name="message" required></textarea></div><div class="col-12"><div class="whatsapp-note mb-3"><i class="fa-brands fa-whatsapp me-2"></i>This form opens WhatsApp with the entered details.</div><button class="btn btn-brand btn-lg" type="submit">Send on WhatsApp</button></div></div></form></div></div><div class="col-lg-5"><div class="info-card h-100"><h3>Contact information</h3><p>Replace the sample phone number and email before publishing.</p><h5 class="mt-4">Phone</h5><p>+91 91671 82720</p><h5>Email</h5><p>info@ewastesolutions.in</p><h5>Location</h5><p>Mumbai, Maharashtra, India</p><h5>Business Hours</h5><p>Monday–Saturday<br>9:30 AM–6:30 PM</p></div></div></div></div></section>
