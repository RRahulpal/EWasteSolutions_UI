@page
@model EWasteSolutions.Pages.Admin.Products.IndexModel

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Products</h2>

    <a asp-page="Create" class="btn btn-success">
        <i class="fa-solid fa-plus"></i>
        Add Product
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Products.Any())
        {
            <div class="text-center py-5">

                <h5>No products found.</h5>

                <a asp-page="Create" class="btn btn-primary mt-3">
                    Add First Product
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">

                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show"
                         role="alert">

                        @TempData["ErrorMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }
                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Name</th>
                            <th>Image</th>
                            <th>Category</th>

                            <th>Brand</th>

                            <th>Price</th>

                            <th>Stock</th>

                            <th>Status</th>

                            <th>Featured</th>

                            <th width="180">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Products)
                        {
                            <tr>
                               
                                    <td>
                                        @{
                                            var primaryImage = item.ProductImages?
                                            .FirstOrDefault(image => image.IsPrimary)
                                            ?? item.ProductImages?.FirstOrDefault();
                                        }

                                        @if (primaryImage != null &&
                                                                    !string.IsNullOrWhiteSpace(primaryImage.ImageUrl))
                                        {
                                            <img src="@primaryImage.ImageUrl"
                                             alt="@item.Name"
                                                 class="rounded border"
                                                 style="width: 70px; height: 70px; object-fit: contain;" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center rounded border bg-light"
                                                 style="width: 70px; height: 70px;">
                                                <i class="fa-regular fa-image text-muted"></i>
                                            </div>
                                        }
                                    </td>

                                <td>@item.Name</td>

                                <td>@item.Category?.Name</td>

                                <td>@item.Brand</td>

                                <td>₹@item.Price.ToString("N2")</td>

                                <td>@item.Stock</td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsFeatured)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Featured
                                        </span>
                                    }
                                </td>

                                <td>

                                    <a asp-page="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">
                                        Edit
                                    </a>

                                    <a asp-page="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>