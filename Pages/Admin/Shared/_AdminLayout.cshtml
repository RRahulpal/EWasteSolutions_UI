@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    bool isDashboard = currentPage.Equals("/Admin/Dashboard", StringComparison.OrdinalIgnoreCase);
    bool isProducts = currentPage.StartsWith("/Admin/Products", StringComparison.OrdinalIgnoreCase);
    bool isCategories = currentPage.StartsWith("/Admin/Categories", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | E Waste Solutions Admin</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    
</head>

<body>
    <div class="admin-wrapper">

        <aside class="admin-sidebar" id="adminSidebar">

            <a href="/Admin/Dashboard" class="admin-brand">
                <img src="/images/logo.png"
                     alt="E Waste Solutions"
                     onerror="this.style.display='none'" />

                <div>
                    <strong>E Waste Solutions</strong>
                    <small>ADMIN PANEL</small>
                </div>
            </a>

            <div class="admin-menu-label">Main</div>

            <nav class="admin-nav">

                <a href="/Admin/Dashboard"
                   class="admin-nav-link @(isDashboard ? "active" : "")">
                    <i class="fa-solid fa-chart-line"></i>
                    Dashboard
                </a>

                <a href="/Admin/Products/Index"
                   class="admin-nav-link @(isProducts ? "active" : "")">
                    <i class="fa-solid fa-laptop"></i>
                    Products
                </a>

                <a href="/Admin/Categories/Index"
                   class="admin-nav-link @(isCategories ? "active" : "")">
                    <i class="fa-solid fa-layer-group"></i>
                    Categories
                </a>

                <a href="#"
                   class="admin-nav-link">
                    <i class="fa-solid fa-truck"></i>
                    Pickup Requests
                </a>

                <a href="#"
                   class="admin-nav-link">
                    <i class="fa-solid fa-envelope"></i>
                    Enquiries
                </a>

            </nav>

            <div class="admin-menu-label">Account</div>

            <nav class="admin-nav">

                <a href="/"
                   class="admin-nav-link">
                    <i class="fa-solid fa-globe"></i>
                    View Website
                </a>

                <form method="post" asp-page="/Admin/Logout">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="admin-nav-link w-100 border-0 text-start bg-transparent">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Logout
                    </button>
                </form>

            </nav>

        </aside>

        <div class="admin-overlay" id="adminOverlay"></div>

        <main class="admin-main">

            <header class="admin-topbar">

                <div class="d-flex align-items-center gap-3">
                    <button type="button"
                            class="sidebar-toggle"
                            id="sidebarToggle">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <h1 class="admin-page-title">
                        @ViewData["Title"]
                    </h1>
                </div>

                <div class="admin-user">
                    <div class="admin-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div class="admin-user-info">
                        <strong>@User.Identity?.Name</strong>
                        <small>Administrator</small>
                    </div>
                </div>

            </header>

            <section class="admin-content">
                @RenderBody()
            </section>

        </main>

    </div>

    <script>
        const sidebar = document.getElementById("adminSidebar");
        const toggle = document.getElementById("sidebarToggle");
        const overlay = document.getElementById("adminOverlay");

        toggle?.addEventListener("click", function () {
            sidebar.classList.toggle("show");
            overlay.classList.toggle("show");
        });

        overlay?.addEventListener("click", function () {
            sidebar.classList.remove("show");
            overlay.classList.remove("show");
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>