@page "{id:int}"
@model EWasteSolutions.Pages.Admin.Categories.DeleteModel

@{
    ViewData["Title"] = "Delete Category";
    Layout = "/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Delete Category</h2>
        <p class="text-muted mb-0">
            Review the category before deleting it.
        </p>
    </div>

    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
        Back to Categories
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <div class="alert alert-danger d-flex align-items-start gap-3">
            <i class="fa-solid fa-triangle-exclamation fa-xl mt-2"></i>

            <div>
                <h5 class="alert-heading mb-1">Delete this category?</h5>
                <p class="mb-0">
                    This action cannot be undone.
                </p>
            </div>
        </div>

        <dl class="row mt-4 mb-0">

            <dt class="col-sm-3">Category Name</dt>
            <dd class="col-sm-9">@Model.Category.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Category.Description)
                                ? "No description"
                                : Model.Category.Description)
            </dd>

            <dt class="col-sm-3">Display Order</dt>
            <dd class="col-sm-9">@Model.Category.DisplayOrder</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Category.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>

        </dl>

        <hr class="my-4" />

        <form method="post" asp-route-id="@Model.Category.Id">
            <input type="hidden" asp-for="Category.Id" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-page="Index" class="btn btn-light border">
                    Cancel
                </a>

                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash me-1"></i>
                    Delete Category
                </button>
            </div>
        </form>

    </div>
</div>