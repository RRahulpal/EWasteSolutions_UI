@page
@model EWasteSolutions.Pages.Admin.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
    Layout = "/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-xmark me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }
    <div>
        <h2 class="fw-bold mb-1">Category Management</h2>
        <p class="text-muted mb-0">
            Manage all product categories.
        </p>
    </div>

    <a asp-page="Create" class="btn btn-success">
        <i class="fa-solid fa-plus"></i>
        Add Category
    </a>
</div>

<div class="card shadow-sm border-0">

    <div class="card-body">

        @if (Model.Categories.Any())
        {
            <div class="table-responsive">
                <form method="get" class="row g-3 align-items-end mb-4">

    <div class="col-lg-4 col-md-6">
        <label class="form-label fw-semibold">Search</label>

        <input asp-for="SearchTerm"
               class="form-control"
               placeholder="Search by name or description..." />
    </div>

    <div class="col-lg-2 col-md-3">
        <label class="form-label fw-semibold">Status</label>

        <select asp-for="Status" class="form-select">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
    </div>

    <div class="col-lg-2 col-md-3">
        <label class="form-label fw-semibold">Sort By</label>

        <select asp-for="SortBy" class="form-select">
            <option value="displayOrder">Display Order</option>
            <option value="name">Name</option>
            <option value="createdAt">Created Date</option>
        </select>
    </div>

    <div class="col-lg-2 col-md-3">
        <label class="form-label fw-semibold">Direction</label>

        <select asp-for="SortDirection" class="form-select">
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
        </select>
    </div>

    <div class="col-lg-2 col-md-3">
        <label class="form-label fw-semibold">Page Size</label>

        <select asp-for="PageSize" class="form-select">
            <option value="10">10 records</option>
            <option value="25">25 records</option>
            <option value="50">50 records</option>
        </select>
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-filter me-1"></i>
            Apply
        </button>
    </div>

    <div class="col-auto">
        <a asp-page="Index" class="btn btn-outline-secondary">
            Clear
        </a>
    </div>

</form>

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th style="width:80px;">#</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Display Order</th>
                            <th>Status</th>
                            <th style="width:180px;">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var category in Model.Categories)
                        {
                            <tr>

                                <td>@category.Id</td>

                                <td class="fw-semibold">
                                    @category.Name
                                </td>

                                <td>
                                    @category.Description
                                </td>

                                <td>
                                    @category.DisplayOrder
                                </td>

                                <td>
                                    @if (category.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>

                                    <a asp-page="Edit"
                                       asp-route-id="@category.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    <a asp-page="Delete"
                                       asp-route-id="@category.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
                @if (Model.TotalRecords > 0)
{
    var startRecord = ((Model.PageNumber - 1) * Model.PageSize) + 1;
    var endRecord = Math.Min(
        Model.PageNumber * Model.PageSize,
        Model.TotalRecords
    );

    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-3 mt-4">

        <div class="text-muted small">
            Showing @startRecord to @endRecord
            of @Model.TotalRecords categories
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Category pagination">
                <ul class="pagination mb-0">

                    <li class="page-item
                        @(Model.PageNumber == 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-page="Index"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchTerm="@Model.SearchTerm">
                            Previous
                        </a>
                    </li>

                                    @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                                    {
                                        <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">

                                            <a class="page-link"
                                               asp-page="Index"
                                               asp-route-pageNumber="@pageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-searchTerm="@Model.SearchTerm"
                                               asp-route-status="@Model.Status"
                                               asp-route-sortBy="@Model.SortBy"
                                               asp-route-sortDirection="@Model.SortDirection">

                                                @pageNumber

                                            </a>
                                        </li>
                                    }

                    <li class="page-item
                        @(Model.PageNumber == Model.TotalPages
                            ? "disabled"
                            : "")">

                        <a class="page-link"
                           asp-page="Index"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchTerm="@Model.SearchTerm">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        }

    </div>
}
            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="fa-solid fa-layer-group fa-4x text-secondary mb-3"></i>

                <h4>No Categories Found</h4>

                <p class="text-muted">
                    Start by creating your first category.
                </p>

                <a asp-page="Create"
                   class="btn btn-success">

                    <i class="fa-solid fa-plus"></i>

                    Add First Category

                </a>

            </div>
        }

    </div>

</div>