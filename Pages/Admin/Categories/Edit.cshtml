@page "{id:int}"
@model EWasteSolutions.Pages.Admin.Categories.EditModel

@{
    ViewData["Title"] = "Edit Category";
    Layout = "/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Edit Category</h2>
        <p class="text-muted mb-0">
            Update category information.
        </p>
    </div>

    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
        Back to Categories
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <form method="post">

            <input type="hidden" asp-for="Category.Id" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="row g-4">

                <div class="col-md-8">
                    <label asp-for="Category.Name"
                           class="form-label fw-semibold">
                        Category Name
                    </label>

                    <input asp-for="Category.Name"
                           class="form-control" />

                    <span asp-validation-for="Category.Name"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Category.DisplayOrder"
                           class="form-label fw-semibold">
                        Display Order
                    </label>

                    <input asp-for="Category.DisplayOrder"
                           class="form-control"
                           type="number"
                           min="0" />

                    <span asp-validation-for="Category.DisplayOrder"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Category.Description"
                           class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea asp-for="Category.Description"
                              class="form-control"
                              rows="5"></textarea>

                    <span asp-validation-for="Category.Description"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="Category.IsActive"
                               class="form-check-input" />

                        <label asp-for="Category.IsActive"
                               class="form-check-label fw-semibold">
                            Active Category
                        </label>
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-page="Index"
                   class="btn btn-light border">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i>
                    Update Category
                </button>
            </div>

        </form>

    </div>
</div>