@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    bool isHome = currentPage.Equals("/Index", StringComparison.OrdinalIgnoreCase);
    bool isAbout = currentPage.Equals("/About", StringComparison.OrdinalIgnoreCase);
    bool isServices = currentPage.StartsWith("/Services", StringComparison.OrdinalIgnoreCase);
    bool isProducts = currentPage.StartsWith("/Products", StringComparison.OrdinalIgnoreCase);
    bool isSustainability = currentPage.Equals("/Sustainability", StringComparison.OrdinalIgnoreCase);
    bool isContact = currentPage.Equals("/Contact", StringComparison.OrdinalIgnoreCase);
    bool isPickup = currentPage.StartsWith("/Pickup", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Waste Solutions</title>
    <meta name="description" content="Professional IT asset disposal, e-waste recycling, refurbishment and secure data destruction services in Mumbai." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light fixed-top site-navbar" id="mainNavbar">
            <div class="container">
                @* <a class="navbar-brand brand-wrap" asp-page="/Index">
                    <span class="brand-icon"><i class="fa-solid fa-recycle"></i></span>
                    <span><strong>E-WASTE</strong><small>SOLUTIONS</small></span>
                </a> *@
                <a class="navbar-brand brand-wrap" asp-page="/Index">

                    <img src="~/images/logo.png"
                         class="company-logo"
                         alt="E Waste Solutions" />

                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainMenu">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                        <li class="nav-item">

                            <a class="nav-link navbar-page-link @(isHome ? "active" : "")"
                               asp-page="/Index"
                               aria-current="@(isHome ? "page" : null)">

                                Home

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link navbar-page-link @(isAbout ? "active" : "")"
                               asp-page="/About"
                               aria-current="@(isAbout ? "page" : null)">

                                About

                            </a>

                        </li>

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle @(isServices ? "active" : "")"
                               href="#"
                               id="servicesDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                Services

                            </a>

                            <ul class="dropdown-menu border-0 shadow-lg"
                                aria-labelledby="servicesDropdown">

                                <li>
                                    <a class="dropdown-item @(currentPage == "/Services/Index" ? "active" : "")"
                                       asp-page="/Services/Index">

                                        All Services

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item @(currentPage == "/Services/ITAssetDisposal" ? "active" : "")"
                                       asp-page="/Services/ITAssetDisposal">

                                        IT Asset Disposal

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item @(currentPage == "/Services/DataDestruction" ? "active" : "")"
                                       asp-page="/Services/DataDestruction">

                                        Data Destruction

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item @(currentPage == "/Services/Refurbishment" ? "active" : "")"
                                       asp-page="/Services/Refurbishment">

                                        Refurbishment

                                    </a>
                                </li>

                            </ul>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link navbar-page-link @(isProducts ? "active" : "")"
                               asp-page="/Products/Index"
                               aria-current="@(isProducts ? "page" : null)">

                                Products

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link navbar-page-link @(isSustainability ? "active" : "")"
                               asp-page="/Sustainability"
                               aria-current="@(isSustainability ? "page" : null)">

                                Sustainability

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link navbar-page-link @(isContact ? "active" : "")"
                               asp-page="/Contact"
                               aria-current="@(isContact ? "page" : null)">

                                Contact

                            </a>

                        </li>

                        <li class="nav-item ms-lg-2">

                            <a class="btn btn-brand pickup-nav-btn @(isPickup ? "active" : "")"
                               asp-page="/Pickup/Create">

                                <i class="fa-solid fa-truck-fast me-2"></i>
                                Request Pickup

                            </a>

                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="footer-brand mb-3"><i class="fa-solid fa-recycle"></i> E-WASTE SOLUTIONS</div>
                    <p>Responsible IT asset disposal, refurbishment, secure data destruction and sustainable e-waste management for businesses and individuals.</p>
                    <div class="social-links">
                        <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Quick Links</h6>
                    <a asp-page="/About">About Us</a>
                    <a asp-page="/Products/Index">Products</a>
                    <a asp-page="/Sustainability">Sustainability</a>
                    <a asp-page="/Contact">Contact</a>
                </div>
                <div class="col-6 col-lg-3">
                    <h6>Services</h6>
                    <a asp-page="/Services/ITAssetDisposal">IT Asset Disposal</a>
                    <a asp-page="/Services/DataDestruction">Data Destruction</a>
                    <a asp-page="/Services/Refurbishment">Refurbishment</a>
                    <a asp-page="/Pickup/Create">Corporate Pickup</a>
                </div>
                <div class="col-lg-3">
                    <h6>Contact</h6>
                    <p class="mb-2"><i class="fa-solid fa-location-dot me-2"></i>Mumbai, Maharashtra</p>
                    <p class="mb-2"><i class="fa-solid fa-phone me-2"></i>+91 9167182720</p>
                    <p class="mb-0"><i class="fa-solid fa-envelope me-2"></i>info@ewastesolutions.in</p>
                </div>
            </div>
            <hr />
            <div class="d-flex flex-column flex-md-row justify-content-between gap-2 small">
                <span>© @DateTime.Now.Year E-Waste Solutions. All rights reserved.</span>
                <span>Responsible Recycling. Secure Disposal. Maximum Value Recovery.</span>
            </div>
        </div>
    </footer>

    <a class="whatsapp-float" href="https://wa.me/918104881897?text=Hello%20E-Waste%20Solutions" target="_blank" aria-label="Chat on WhatsApp">
        <i class="fa-brands fa-whatsapp"></i>
    </a>
    <button id="backToTop" class="back-to-top" aria-label="Back to top"><i class="fa-solid fa-arrow-up"></i></button>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
